# Скопіюйте цей файл у .env і задайте власні значення. Файл .env не потрапляє в Git.
PORT=3000
NODE_ENV=development
# Секрет для підпису сесійних cookie: довгий випадковий рядок (наприклад, результат
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me-to-a-long-random-string
# Пароль облікового запису адміністратора (admin@znannyaplus.com.ua), що створюється під час першого запуску
ADMIN_PASSWORD=change-me-Admin2026
# Шлях до файлу бази даних SQLite
DB_PATH=data/znannyaplus.db
